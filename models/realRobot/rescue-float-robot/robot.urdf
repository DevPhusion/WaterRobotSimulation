  <!-- ================= DUMMY THRUSTER PROP LINKS =================
       The original URDF had no joints at all, so the gz-sim-thruster-system
       plugins (joint_name: leftmotor / rightmotor) had nothing to attach to
       and errored out. These are small massless-ish dummy "prop" links +
       revolute joints, named to match the existing thruster plugin joint
       names (leftmotor / rightmotor) so no changes are needed on the SDF
       plugin side.

       FIX (this revision): the joint origins were previously an arbitrary,
       symmetric ±0.14 offset that didn't correspond to either physical
       motor assembly, so the dummy prop cylinders rendered floating off to
       the side of the model instead of on the actual propellers. Each
       motor assembly in this URDF is a stack of parts (case_part_1/2/3,
       motor, extension_shaft, extension) sharing one origin, plus a
       "composite_part_1" (the propeller/impeller) offset from that origin
       along local +Y by the shaft length. The two assemblies are:
         - assembly A: case/motor origin (-0.275871, -0.159253, -0.00865457),
           propeller (composite_part_1)  at (-0.275871, -0.0821154, -0.00865457)
         - assembly B: case/motor origin ( 0.0341294, -0.159253, -0.00865457),
           propeller (composite_part_1_2) at (0.0341294, -0.0821154, -0.00865457)
       The dummy prop joints are now placed at the propeller (composite_part_1)
       positions, not the motor housing, since that's the part that visually
       spins. Naming/sign convention (positive local X = "leftmotor") is kept
       the same as before: assembly B (positive X) -> leftmotor, assembly A
       (negative X) -> rightmotor.

       Rotation is unchanged from before: body's local +Y is the boat's
       fore-aft axis (the model-level yaw of -1.5708 in the world file
       rotates local Y to world +X / "forward"), and local X is the
       left-right/width axis. Roll (-1.5708 about X) rotates the cylinder's
       spin axis (local Z) onto local Y, so it points fore-aft like a real
       propeller instead of side-to-side like a paddle wheel. -->
  <link name="left_prop">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.07"/>
      </geometry>
      <material name="left_prop_material">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>
  <joint name="leftmotor" type="continuous">
    <parent link="body"/>
    <child link="left_prop"/>
    <!-- Aligned to composite_part_1_2 (assembly B's propeller). -->
    <origin xyz="0.0341294 -0.0821154 -0.00865457" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_prop">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.07"/>
      </geometry>
      <material name="right_prop_material">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>
  <joint name="rightmotor" type="continuous">
    <parent link="body"/>
    <child link="right_prop"/>
    <!-- Aligned to composite_part_1 (assembly A's propeller). -->
    <origin xyz="-0.275871 -0.0821154 -0.00865457" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>