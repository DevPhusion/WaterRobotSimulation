<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="water_test">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <background_color>0.8 0.8 0.8</background_color>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- ================= WIND =================
         Built-in gz-sim wind model. Only links with <enable_wind>true</enable_wind>
         are affected (see the hull link below). -->
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1.0</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>5</time_for_rise>
          <sin>
            <amplitude_percent>0.05</amplitude_percent>
            <period>60</period>
          </sin>
          <noise type="gaussian">
            <mean>2.0</mean>
            <stddev>0.5</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>2</time_for_rise>
          <sin>
            <amplitude>5</amplitude>
            <period>20</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>2</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <time_for_rise>5</time_for_rise>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.05</stddev>
        </noise>
      </vertical>
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
    </scene>

    <light type="directional" name="world_sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.3 0.3 -0.9</direction>
    </light>

    <!-- ================= WAVE FIELD =================
         Local copy of the "waves" model, referenced by absolute path so it
         doesn't depend on GZ_SIM_RESOURCE_PATH being set correctly. -->
    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>/home/phusion/gz_ws/worlds/CrestWaterRobot/models/waves</uri>
    </include>

    <!-- ================= OCEAN CURRENT =================
         No plugin needed here: the Hydrodynamics system attached to "body" below
         already listens on /ocean_current:
           gz topic -t /ocean_current -m gz.msgs.Vector3d -p 'x: 1.0, y: 0.3, z: 0' -->

    <!-- ================= PID TEST PATH =================
         Two stationary, non-colliding markers defining the straight-line
         path the boat should hold in PID mode. Their positions MUST match
         START_POINT / END_POINT in the control script — if you move one,
         move the other. Boat spawns at (0,0) facing +x (yaw 0), so the
         line runs straight down the +x axis by default. -->
    <model name="start_marker">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="end_marker">
      <static>true</static>
      <pose>20 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= ACTUAL ROBOT =================
         rescue-float-robot, loaded from the URDF exported by onshape-to-robot.
         Wrapped in a <model> with merge="true" on the <include> (SDFormat 1.9
         "merge-include"), so the URDF's links/joints get folded into this
         model, letting us attach plugins alongside it — <plugin> can't be a
         direct child of <include> itself.
         Link/joint names come from the URDF: hull link is "body",
         thruster joints are "leftmotor" / "rightmotor". -->
    <model name="rescue_float_robot">
      <pose>0 0 0.1 0 0.031 -1.5708</pose>

      <include merge="true">
        <uri>/home/phusion/gz_ws/worlds/CrestWaterRobot/models/robot/rescue-float-robot/robot.urdf</uri>
      </include>

      <!-- Wave-aware hydrodynamics from asv_wave_sim: buoyancy against the live
           wave surface + drag/damping, and it listens on /ocean_current for
           current forcing. -->
      <plugin filename="gz-waves1-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
        <enable>rescue_float_robot::body</enable>
        <hydrodynamics>
          <damping_on>1</damping_on>
          <viscous_drag_on>1</viscous_drag_on>
          <pressure_drag_on>1</pressure_drag_on>

          <cDampL1>1.0E-6</cDampL1>
          <cDampL2>1.0E-6</cDampL2>
          <cDampR1>1.0E-6</cDampR1>
          <cDampR2>1.0E-6</cDampR2>

          <cPDrag1>1.0E+2</cPDrag1>
          <cPDrag2>1.0E+2</cPDrag2>
          <fPDrag>0.4</fPDrag>
          <cSDrag1>1.0E+2</cSDrag1>
          <cSDrag2>1.0E+2</cSDrag2>
          <fSDrag>0.4</fSDrag>
          <vRDrag>1.0</vRDrag>
        </hydrodynamics>
        <markers>
          <update_rate>10</update_rate>
          <water_patch>0</water_patch>
          <waterline>0</waterline>
          <underwater_surface>0</underwater_surface>
        </markers>
      </plugin>

      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
        <joint_name>leftmotor</joint_name>
        <thrust_coefficient>0.005</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.08</propeller_diameter>
      </plugin>

      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
        <joint_name>rightmotor</joint_name>
        <thrust_coefficient>0.005</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.08</propeller_diameter>
      </plugin>

    </model>

  </world>
</sdf>