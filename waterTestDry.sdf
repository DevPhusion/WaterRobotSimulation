<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="dry_test">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <background_color>0.8 0.8 0.8</background_color>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- No wind plugin, no wave/hydrodynamics plugin, no ocean current -->

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
    </scene>

    <light type="directional" name="world_sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.3 0.3 -0.9</direction>
    </light>

    <!-- ================= GROUND PLANE =================
         Plain flat ground so the robot can drive over it. Friction values
         are generic mid-range defaults; tweak if the robot's real contact
         surfaces (skids/wheels/hull) need something different. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= PID TEST PATH =================
         Same start/end markers as the water world, unchanged, so the same
         control script / START_POINT / END_POINT values still apply.
         Boat spawns at (0,0) facing +x (yaw 0). -->
    <model name="start_marker">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="end_marker">
      <static>true</static>
      <pose>20 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= ACTUAL ROBOT =================
         Now points at the NEW model: models/realRobot/rescue-float-robot
         (was models/robot/rescue-float-robot, the old buggy model that
         caused the simulation to explode).

         Spawned a bit higher (z=0.3 instead of 0.1) so it drops onto the
         ground plane under gravity rather than starting clipped into it.

         IMPORTANT: the Hydrodynamics plugin and the wave/wind plugins have
         been removed entirely. Only the Thruster plugins remain, since
         those drive the "leftmotor"/"rightmotor" joints regardless of
         whether the robot is in water. This isolates whether the odd
         movement comes from the robot/thrusters/joints themselves (still
         weird here => robot/URDF/thruster issue) or from the water
         interaction (fine here => hydrodynamics/wave plugin issue).

         NOTE: the referenced robot.urdf ("package://assets\..." paths) has
         been fixed to use forward slashes ("package://assets/...") since
         the backslashes were breaking mesh/resource resolution on
         Linux/gz-sim.

         NOTE 2: the URDF originally defined no joints at all, so the
         gz-sim-thruster-system plugins below (joint_name leftmotor /
         rightmotor) had nothing to act on and errored out. Small dummy
         "prop" links + revolute joints named "leftmotor" and "rightmotor"
         have now been added directly to the URDF's "body" link, the same
         way water_test.sdf adds its left_prop/right_prop dummy props to
         "hull" - see the updated robot.urdf/robot.xml. No changes were
         needed to the Thruster plugin blocks below since their joint_name
         values already match. -->
    <model name="rescue_float_robot">
      <pose>0 0 0.3 0 0.031 -1.5708</pose>

      <include merge="true">
        <uri>/home/phusion/gz_ws/worlds/CrestWaterRobot/models/realRobot/rescue-float-robot/robot.urdf</uri>
      </include>

      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
        <joint_name>leftmotor</joint_name>
        <thrust_coefficient>0.005</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.08</propeller_diameter>
      </plugin>

      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
        <joint_name>rightmotor</joint_name>
        <thrust_coefficient>0.005</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.08</propeller_diameter>
      </plugin>

    </model>

  </world>
</sdf>